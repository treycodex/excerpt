{
  "name": "excerpt",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:engine": "pnpm --filter @excerpt/core build:engine",
    "build:editor": "pnpm --filter @excerpt/editor build:notes",
    "build:mac": "pnpm build:engine && pnpm build:editor && cd apps/mac && ./build.sh",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
